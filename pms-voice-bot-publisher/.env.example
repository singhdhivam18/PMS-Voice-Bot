# ============================================================
# PMS Voice Bot Publisher
# ============================================================

# ---------------- SQL Server ----------------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=car-voice-db
DB_USER=sa
DB_PASSWORD=<set-locally>
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_CONN_TIMEOUT=10


# ---------------- RabbitMQ ----------------
# Used for standalone/local execution.
# Docker Compose may override this value.
RABBITMQ_URL=amqp://<rabbitmq-user>:<rabbitmq-password>@localhost:5672/%2F

RABBITMQ_EXCHANGE=car_service_events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_ROUTING_KEY=maintenance.call.requested
RABBITMQ_QUEUE=maintenance_call_requested_queue
RABBITMQ_PUBLISH_CONFIRM=true


# ---------------- Business Rules ----------------
# window = due today through today + LEAD_DAYS
# exact  = due exactly today + LEAD_DAYS
# asis   = due date >= today

QUERY_MODE=window
LEAD_DAYS=2


# ---------------- Scheduling ----------------
# loop = keep running on the configured interval
# once = execute one publish pass and exit

RUN_MODE=loop
SCHEDULE_INTERVAL_MINUTES=60
RUN_IMMEDIATELY_ON_START=true


# ---------------- Health Check ----------------
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=8080


# ---------------- Logging ----------------
LOG_LEVEL=INFO