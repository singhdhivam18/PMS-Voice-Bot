# Keep this server-side only. Never put it in frontend JavaScript.
ELEVENLABS_API_KEY=

# From your ElevenLabs agent configuration.
ELEVENLABS_AGENT_ID=agent_7901m24tek7bf7xrn1wqvzbdawyz

# ElevenLabs phone_number_id for the Twilio-integrated number that makes the call.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=phnum_8201m24vrz0kfbas7gxs1jf06mwt

# Twilio recording is optional. Leave false unless you explicitly need it.
ELEVENLABS_CALL_RECORDING_ENABLED=false

# Secret configured for the ElevenLabs post-call webhook.
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_WEBHOOK_MAX_AGE_SECONDS=300

