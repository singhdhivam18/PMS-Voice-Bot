DB_HOST=localhost
DB_PORT=5432
DB_NAME=dev-voice-db
DB_USER=postgres
DB_PASSWORD=Test@123
DB_DRIVER=PostgreSQL Unicode(x64)
DB_CONN_TIMEOUT=10

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
RABBITMQ_EXCHANGE=car_service_events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_QUEUE=maintenance_call_requested_queue
RABBITMQ_ROUTING_KEY=maintenance.call.requested

# Voice Agent / FastAPI
VOICE_AGENT_BASE_URL=http://localhost:8000
VOICE_AGENT_CALLBACK_URL=http://localhost:8081/api/voice/callback
VOICE_AGENT_DEPOT_NAME=Bangalore Central Depot
VOICE_AGENT_TIMEOUT=330

# Callback payload storage
CALLBACK_PAYLOAD_DIR=./callback_payloads

# Health / logging
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=8081
LOG_LEVEL=INFO
